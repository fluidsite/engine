# Fluidsite engine credentials. Copy to .env and fill in. Never commit .env.

# GitHub: used to push branches and manage site repos.
GITHUB_TOKEN=

# Cloudflare: Pages preview URLs and Web Analytics.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Anthropic: Claude vision (price-list extraction) and Claude Code headless edits.
ANTHROPIC_API_KEY=
